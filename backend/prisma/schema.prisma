generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// ROLES Y USUARIOS
// --------------------------------------------------------

model Rol {
  idRol     Int       @id @default(autoincrement()) @map("ID_Rol")
  nombreRol String?   @map("NombreRol") @db.VarChar(100)
  usuarios  Usuario[]

  @@map("roles")
}

model Usuario {
  idUsuario        Int               @id @default(autoincrement()) @map("ID_Usuario")
  nombre           String?           @map("Nombre") @db.VarChar(100)
  correo           String            @unique @map("Correo") @db.VarChar(100)
  contrasena       String?           @map("Contraseña") @db.VarChar(255)
  idRol            Int?              @map("ID_Rol")
  direccion        String?           @map("Direccion") @db.VarChar(100)
  telefono         String?           @map("Telefono") @db.Char(10)
  estatus          String?           @map("Estatus") @db.VarChar(50)
  
  rol              Rol?              @relation(fields: [idRol], references: [idRol])
  carritos         Carrito[]
  pedidos          Pedido[]
  facturas         Factura[]
  actividades      ActividadSesion[]

  @@map("usuarios")
}

// --------------------------------------------------------
// CATÁLOGO DE PRODUCTOS, CATEGORÍAS Y TALLAS
// --------------------------------------------------------

model Categoria {
  idCategoria Int         @id @default(autoincrement()) @map("id_categoria")
  nombre      String      @db.VarChar(100)
  parentId    Int?        @map("ParentID")
  
  parent      Categoria?  @relation("CategoriaPadre", fields: [parentId], references: [idCategoria])
  subcategorias Categoria[] @relation("CategoriaPadre")
  productos   Producto[]

  @@map("categorias")
}

model Producto {
  idProducto    Int             @id @default(autoincrement()) @map("id_producto")
  nombre        String?         @db.VarChar(100)
  precio        Decimal?        @db.Decimal(10, 2)
  categoriaId   Int?            @map("categoria")
  imagen        String?         @db.VarChar(255)

  categoria     Categoria?      @relation(fields: [categoriaId], references: [idCategoria])
  tallas        ProductoTalla[]
  carritos      Carrito[]
  detallesPedido DetallePedido[]

  @@map("productos")
}

model Talla {
  idTalla       Int             @id @default(autoincrement()) @map("id_talla")
  nombre        String          @db.VarChar(10)
  orden         Int?
  
  productoTallas ProductoTalla[]

  @@map("tallas")
}

model ProductoTalla {
  idProductoTalla Int       @id @default(autoincrement()) @map("id_producto_talla")
  idProducto      Int       @map("id_producto")
  idTalla         Int       @map("id_talla")
  stock           Int?      @default(0)

  producto        Producto  @relation(fields: [idProducto], references: [idProducto], onDelete: Cascade)
  talla           Talla     @relation(fields: [idTalla], references: [idTalla])
  carritos        Carrito[]
  detallesPedido  DetallePedido[]

  @@unique([idProducto, idTalla], name: "unique_producto_talla")
  @@map("producto_tallas")
}

// --------------------------------------------------------
// CARRITO, PEDIDOS Y FACTURACIÓN
// --------------------------------------------------------

model Carrito {
  idCarrito       Int            @id @default(autoincrement()) @map("id_carrito")
  idUsuario       Int?           @map("id_usuario")
  idProducto      Int?           @map("id_producto")
  idProductoTalla Int?           @map("id_producto_talla")
  cantidad        Int            @default(1)
  total           Decimal?       @db.Decimal(10, 2)
  fechaAgregado   DateTime       @default(now()) @map("fecha_agregado")

  usuario         Usuario?       @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)
  producto        Producto?      @relation(fields: [idProducto], references: [idProducto])
  productoTalla   ProductoTalla? @relation(fields: [idProductoTalla], references: [idProductoTalla])

  @@map("carrito")
}

model Pedido {
  idPedido    Int             @id @default(autoincrement()) @map("id_pedido")
  idUsuario   Int?            @map("id_usuario")
  fechaPedido DateTime?       @default(now()) @map("fecha_pedido")
  total       Decimal?        @db.Decimal(10, 2)

  usuario     Usuario?        @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)
  detalles    DetallePedido[]
  facturas    Factura[]

  @@map("pedidos")
}

model DetallePedido {
  idPedido        Int            @map("id_pedido")
  idProducto      Int            @map("id_producto")
  idProductoTalla Int            @map("id_producto_talla")
  cantidad        Int?
  precioUnitario  Decimal?       @map("precio_unitario") @db.Decimal(10, 2)

  pedido          Pedido         @relation(fields: [idPedido], references: [idPedido], onDelete: Cascade)
  producto        Producto       @relation(fields: [idProducto], references: [idProducto], onDelete: Cascade)
  productoTalla   ProductoTalla  @relation(fields: [idProductoTalla], references: [idProductoTalla], onDelete: Cascade)

  @@id([idPedido, idProducto, idProductoTalla])
  @@map("detalle_pedido")
}

model Factura {
  idFactura     Int       @id @default(autoincrement()) @map("id_factura")
  idUsuario     Int?      @map("id_usuario")
  idPedido      Int?      @map("id_pedido")
  rutaPdf       String?   @map("ruta_pdf") @db.VarChar(255)
  fechaCreacion DateTime? @default(now()) @map("fecha_creacion")

  usuario       Usuario?  @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)
  pedido        Pedido?   @relation(fields: [idPedido], references: [idPedido], onDelete: Cascade)

  @@map("facturas")
}

// --------------------------------------------------------
// VERIFICACIONES Y SESIONES
// --------------------------------------------------------

model ActividadSesion {
  idRegistro  Int       @id @default(autoincrement()) @map("ID_Registro")
  idUsuario   Int?      @map("ID_Usuario")
  fechaInicio DateTime? @map("FechaInicio")
  fechaFin    DateTime? @map("FechaFin")

  usuario     Usuario?  @relation(fields: [idUsuario], references: [idUsuario])

  @@map("actividadsesion")
}

model Recuperacion {
  id        Int      @id @default(autoincrement()) @map("ID")
  correo    String   @map("Correo") @db.VarChar(255)
  codigo    String   @map("Codigo") @db.VarChar(32)
  expiresAt DateTime @map("ExpiresAt")
  createdAt DateTime @map("CreatedAt")

  @@map("recuperaciones")
}

model Verificacion {
  id             Int       @id @default(autoincrement()) @map("ID")
  nombre         String    @map("Nombre") @db.VarChar(100)
  correo         String    @map("Correo") @db.VarChar(100)
  contrasenaHash String    @map("ContrasenaHash") @db.VarChar(255)
  token          String    @unique @map("Token") @db.VarChar(64)
  codigo         String?   @map("Codigo") @db.VarChar(16)
  expiresAt      DateTime  @map("ExpiresAt")
  createdAt      DateTime? @default(now()) @map("CreatedAt")

  @@map("verificaciones")
}